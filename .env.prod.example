# Production – copy to .env.prod and fill in real values.
# Use these SAME values in Render (or your host) Environment Variables.
# Never commit .env.prod (it's in .gitignore).

NODE_ENV=production
PORT=5050

# MongoDB Atlas (production cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority

# JWT – use a long random string (32+ chars), different from staging
JWT_SECRET=generate-with-openssl-rand-hex-64

# QR check-in HMAC secret – separate from JWT_SECRET; set in secrets manager only
QR_SIGNING_SECRET=generate-with-openssl-rand-hex-64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
USE_HTTPONLY_COOKIE=true

# Session – refresh cookie: HttpOnly + Secure + SameSite=strict (production).
# Access JWT in localStorage; invalidated on logout via sessionVersion.
# Frontend idle timeouts (optional, ms): admin 14400000, employee 28800000, kiosk 300000

# Security – login lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MS=900000

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5

# Security – CSRF
CSRF_ENABLED=true
CSRF_HEADER_NAME=x-csrf-token

# Data retention (days)
RETENTION_DAYS_DEFAULT=365
ANALYTICS_RETENTION_DAYS=365

# Audit log retention (min 365 days; use external cron on multi-instance – disable in-app cron)
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_CRON_ENABLED=false
AUDIT_RETENTION_CRON_SCHEDULE=0 2 * * *
AUDIT_RETENTION_SYSTEM_USER_ID=
AUDIT_RETENTION_RUN_ON_STARTUP=false
AUDIT_LOG_STRICT=false
INVITE_TTL_MINUTES=60
INVITE_REDIRECT_ALLOWLIST=https://your-app.com
QR_TOKEN_EXPIRES_MINUTES=480
REQUIRE_DB_TLS=true
PROD_DB_KEYWORDS=prod,production
ALLOW_NONPROD_PROD_DB=false

# Your production frontend URL(s), comma-separated if multiple
CORS_ORIGIN=https://your-app.com

# Email (production SMTP or provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# For links in emails (password reset, etc.)
FRONTEND_URL=https://your-app.com
